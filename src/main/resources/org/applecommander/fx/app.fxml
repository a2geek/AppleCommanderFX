<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.canvas.Canvas?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.applecommander.fx.AppController">
    <fx:define>
        <ToggleGroup fx:id="contentModeGroup" />
        <ToggleGroup fx:id="viewModeGroup" />
    </fx:define>

    <top>
        <ToolBar>
            <items>
                <Button onAction="#openDisk" style="-fx-padding: 4 8 4 8; -fx-background-radius: 0;">
                    <graphic>
                        <VBox alignment="CENTER" spacing="2">
                            <ImageView fitWidth="24" fitHeight="24" preserveRatio="true">
                                <image>
                                    <Image url="@/org/applecommander/images/open-file.png" />
                                </image>
                            </ImageView>
                            <Label text="Open" />
                        </VBox>
                    </graphic>
                </Button>
                <Separator orientation="VERTICAL" />
                <HBox spacing="0">
                    <children>
                        <ToggleButton fx:id="filesContentButton" toggleGroup="$contentModeGroup" selected="true" onAction="#selectFilesContent" disable="true" style="-fx-padding: 4 8 4 8; -fx-background-radius: 0; -fx-border-radius: 0; -fx-background-insets: 0;">
                            <graphic>
                                <VBox alignment="CENTER" spacing="2">
                                    <ImageView fitWidth="24" fitHeight="24" preserveRatio="true">
                                        <image>
                                            <Image url="@/org/applecommander/images/tree-view.png" />
                                        </image>
                                    </ImageView>
                                    <Label text="Files" />
                                </VBox>
                            </graphic>
                        </ToggleButton>
                        <ToggleButton fx:id="diskUsageContentButton" toggleGroup="$contentModeGroup" onAction="#selectDiskUsageContent" disable="true" style="-fx-padding: 4 8 4 8; -fx-background-radius: 0; -fx-border-radius: 0; -fx-background-insets: 0;">
                            <graphic>
                                <VBox alignment="CENTER" spacing="2">
                                    <ImageView fitWidth="24" fitHeight="24" preserveRatio="true">
                                        <image>
                                            <Image url="@/org/applecommander/images/disk-usage-view.png" />
                                        </image>
                                    </ImageView>
                                    <Label text="Disk Usage" />
                                </VBox>
                            </graphic>
                        </ToggleButton>
                    </children>
                </HBox>
                <Separator orientation="VERTICAL" />
                <HBox spacing="0">
                    <children>
                        <ToggleButton fx:id="standardToolButton" toggleGroup="$viewModeGroup" selected="true" onAction="#selectStandardView" disable="true" style="-fx-padding: 4 8 4 8; -fx-background-radius: 0; -fx-border-radius: 0; -fx-background-insets: 0;">
                            <graphic>
                                <VBox alignment="CENTER" spacing="2">
                                    <ImageView fitWidth="24" fitHeight="24" preserveRatio="true">
                                        <image>
                                            <Image url="@/org/applecommander/images/selection-standard.png" />
                                        </image>
                                    </ImageView>
                                    <Label text="Standard" />
                                </VBox>
                            </graphic>
                        </ToggleButton>
                        <ToggleButton fx:id="nativeToolButton" toggleGroup="$viewModeGroup" onAction="#selectNativeView" disable="true" style="-fx-padding: 4 8 4 8; -fx-background-radius: 0; -fx-border-radius: 0; -fx-background-insets: 0;">
                            <graphic>
                                <VBox alignment="CENTER" spacing="2">
                                    <ImageView fitWidth="24" fitHeight="24" preserveRatio="true">
                                        <image>
                                            <Image url="@/org/applecommander/images/selection-native.png" />
                                        </image>
                                    </ImageView>
                                    <Label text="Native" />
                                </VBox>
                            </graphic>
                        </ToggleButton>
                        <ToggleButton fx:id="detailToolButton" toggleGroup="$viewModeGroup" onAction="#selectDetailView" disable="true" style="-fx-padding: 4 8 4 8; -fx-background-radius: 0; -fx-border-radius: 0; -fx-background-insets: 0;">
                            <graphic>
                                <VBox alignment="CENTER" spacing="2">
                                    <ImageView fitWidth="24" fitHeight="24" preserveRatio="true">
                                        <image>
                                            <Image url="@/org/applecommander/images/selection-detail.png" />
                                        </image>
                                    </ImageView>
                                    <Label text="Detail" />
                                </VBox>
                            </graphic>
                        </ToggleButton>
                    </children>
                </HBox>
            </items>
        </ToolBar>
    </top>

    <center>
        <StackPane>
            <children>
                <TableView fx:id="fileTable" prefWidth="1100" prefHeight="600">
                    <placeholder>
                        <VBox alignment="CENTER" spacing="10">
                            <ImageView preserveRatio="true">
                                <image>
                                    <Image url="@/org/applecommander/images/AppleCommanderLogo.png" />
                                </image>
                            </ImageView>
                            <Label text="No disk image open. Use File &gt; Open to browse for a disk image." style="-fx-font-size: 14px;" />
                        </VBox>
                    </placeholder>
                </TableView>

                <VBox fx:id="diskUsagePane" alignment="TOP_CENTER" spacing="8" visible="false" managed="false">
                    <Canvas fx:id="diskUsageCanvas" width="800" height="480" />
                    <HBox fx:id="legendBox" alignment="CENTER" spacing="12" />
                </VBox>
            </children>
        </StackPane>
    </center>

    <bottom>
        <Label fx:id="statusLabel" text="No disk image opened." />
    </bottom>
</BorderPane>
